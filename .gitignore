# ==============================================================================
# VELVET AI — .gitignore (Seguridad, Entorno y Gobernanza de Código)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales, Tokens y Variables de Entorno (CRÍTICO)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
data/credentials.json
credentials.json
**/current_jwt.txt
*token*.txt
*jwt*.txt
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. Perfiles de Navegación, Sesiones y Cookies de Automatización
# ------------------------------------------------------------------------------
data/browser_profiles/
**/browser_profiles/
data/sessions/
**/sessions/
.playwright/
.playwright-mcp/
Crashpad/
GPUPersistentCache/
GrShaderCache/
ShaderCache/

# ------------------------------------------------------------------------------
# 3. Bases de Datos Locales y Archivos Binarios de Analítica
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/velvet_analytics.db
*.pma

# ------------------------------------------------------------------------------
# 4. Capturas de Pantalla y Artefactos Temporales de Ejecución
# ------------------------------------------------------------------------------
artifacts/*.png
artifacts/*.jpg
artifacts/*.jpeg
artifacts/*.txt
!artifacts/README.md
!artifacts/.gitkeep

# ------------------------------------------------------------------------------
# 5. Dependencias y Entornos Virtuales (Node.js & Python)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/

# ------------------------------------------------------------------------------
# 6. Logs y Depuración
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. Editores y Archivos del Sistema Operativo
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
DOCUMENTOS
INFORMES Y AUDITORIAS

# ------------------------------------------------------------------------------
# 8. Archivos Temporales de Agentes / Scratch
# ------------------------------------------------------------------------------
scratch/
*scratchpad*
tmp/
temp/
.agents/
.claude/
.codex/
Claude outputs/